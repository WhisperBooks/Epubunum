{ @abstract(EpubReader's Steam Input action manifest and its default
  layouts, inside the program.)

  GENERATED by tools/gen_reader_input.py (with TSteamAPI's
  tools/gen_input_mapping.py) - never edit by hand: change the tables
  there and run it again. Layout revision 2.5.

  ReaderInputWrite writes them into a folder (the manifest at the top,
  the layouts in controllers/), whose manifest is then given to Steam.

  The menu's keys and pointer are tabled here too (READER_MENU_KEYS,
  READER_MENU_POINTER): Steam Input has no keyboard or mouse device, so
  the one definition of every button and key is the generator's tables.
  A program asks ReaderMenuKeyAction / ReaderMenuPointerAction which
  ACTION of the manifest a key or a click means, and acts on the action
  as it does for a pad. }
unit uReaderInput;

interface

type
  { One key of the menu and the action it means. }
  TReaderInputKey = record
    { The action's name in the manifest ('Up'). }
    Action: string;
    { The virtual key (vkUp = 38 ...); 0 when it is a character. }
    Key: Word;
    { The character, upper case; #0 when it is a virtual key. }
    KeyChar: WideChar;
    { What a list of the controls calls it ('Up', 'W', 'Space'). }
    Title: string;
  end;

  { One use of the mouse or a finger on the menu and the action it means. }
  TReaderInputPointer = record
    { The action's name in the manifest ('Back'). }
    Action: string;
    { What was done, as uPadMenu reports it ('right click'). }
    Gesture: string;
  end;

const
  { The manifest's file name. }
  READER_INPUT_MANIFEST = 'epubreader_controllers.vdf';
  { The layouts' revision (Steam reports it back when it loads one). }
  READER_INPUT_REVISION = 5;
  { The layouts' major revision: raised when an interaction is added or
    taken away. }
  READER_INPUT_MAJOR = 2;
  { The menu's keys; an action's first key is the one a hint names. }
  READER_MENU_KEYS: array[0..12] of TReaderInputKey = (
    (Action: 'Up'; Key: 38; KeyChar: #0; Title: 'Up'),
    (Action: 'Up'; Key: 0; KeyChar: 'W'; Title: 'W'),
    (Action: 'Down'; Key: 40; KeyChar: #0; Title: 'Down'),
    (Action: 'Down'; Key: 0; KeyChar: 'S'; Title: 'S'),
    (Action: 'Left'; Key: 37; KeyChar: #0; Title: 'Left'),
    (Action: 'Left'; Key: 0; KeyChar: 'A'; Title: 'A'),
    (Action: 'Right'; Key: 39; KeyChar: #0; Title: 'Right'),
    (Action: 'Right'; Key: 0; KeyChar: 'D'; Title: 'D'),
    (Action: 'Play'; Key: 13; KeyChar: #0; Title: 'Enter'),
    (Action: 'Back'; Key: 27; KeyChar: #0; Title: 'Esc'),
    (Action: 'Menu'; Key: 116; KeyChar: #0; Title: 'F5'),
    (Action: 'Library'; Key: 117; KeyChar: #0; Title: 'F6'),
    (Action: 'Again'; Key: 0; KeyChar: 'H'; Title: 'H'));
  { The menu's pointer: the mouse and a finger. }
  READER_MENU_POINTER: array[0..4] of TReaderInputPointer = (
    (Action: 'Play'; Gesture: 'left click'),
    (Action: 'Play'; Gesture: 'tap'),
    (Action: 'Back'; Gesture: 'right click'),
    (Action: 'Up'; Gesture: 'wheel up'),
    (Action: 'Down'; Gesture: 'wheel down'));

{ The action a key of the menu means.
  @param(AKey  the virtual key of a key event (0 = none))
  @param(AKeyChar  its character (#0 = none))
  @returns(the action's name in the manifest, '' when the key means none) }
function ReaderMenuKeyAction(AKey: Word; AKeyChar: WideChar): string;

{ The action a use of the mouse or a finger on the menu means.
  @param(AGesture  what was done ('right click', 'wheel up' ...))
  @returns(the action's name in the manifest, '' when it means none) }
function ReaderMenuPointerAction(const AGesture: string): string;

{ The keys of action AAction, for a list of the controls: 'Up, W'.
  @param(AAction  the action's name in the manifest)
  @param(AWithPointer  the mouse and the finger after them: ', wheel up')
  @returns(the names, '' when the action has no key) }
function ReaderMenuKeyNames(const AAction: string; AWithPointer: Boolean): string;

{ The first key of action AAction, for a hint: 'Enter'.
  @param(AAction  the action's name in the manifest)
  @returns(its name, '' when the action has no key) }
function ReaderMenuFirstKey(const AAction: string): string;

{ Writes the manifest and the layouts into AFolder (made if needed);
  a file already as it should be is left alone.
  @param(AFolder  the folder)
  @returns(the manifest's full path) }
function ReaderInputWrite(const AFolder: string): string;

