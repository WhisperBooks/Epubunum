{ AText into AFile (CR LF lines), unless it holds that already. }
procedure Put(const AFile: string; const ALines: array of string);
var
  S: string;
  I: Integer;
begin
  S := '';
  for I := 0 to High(ALines) do
    S := S + ALines[I] + #13#10;
  if TFile.Exists(AFile) and (TFile.ReadAllText(AFile, TEncoding.ASCII) = S) then
    Exit;
  TDirectory.CreateDirectory(ExtractFileDir(AFile));
  TFile.WriteAllText(AFile, S, TEncoding.ASCII);
end;

function ReaderMenuKeyAction(AKey: Word; AKeyChar: WideChar): string;
var
  I: Integer;
  C: WideChar;
begin
  Result := '';
  C := UpCase(AKeyChar);
  // a letter or the space bar comes as a character on most systems, as
  // the virtual key alone on some
  if (C = #0) and (((AKey >= Ord('A')) and (AKey <= Ord('Z'))) or (AKey = 32)) then
    C := WideChar(AKey);
  for I := 0 to Length(READER_MENU_KEYS) - 1 do
    if ((READER_MENU_KEYS[I].Key <> 0) and (READER_MENU_KEYS[I].Key = AKey)) or
      ((READER_MENU_KEYS[I].KeyChar <> #0) and (READER_MENU_KEYS[I].KeyChar = C)) then
      Exit(READER_MENU_KEYS[I].Action);
end;

function ReaderMenuPointerAction(const AGesture: string): string;
var
  I: Integer;
begin
  Result := '';
  for I := 0 to Length(READER_MENU_POINTER) - 1 do
    if SameText(READER_MENU_POINTER[I].Gesture, AGesture) then
      Exit(READER_MENU_POINTER[I].Action);
end;

function ReaderMenuKeyNames(const AAction: string; AWithPointer: Boolean): string;
var
  I: Integer;
begin
  Result := '';
  for I := 0 to Length(READER_MENU_KEYS) - 1 do
    if SameText(READER_MENU_KEYS[I].Action, AAction) then
    begin
      if Result <> '' then
        Result := Result + ', ';
      Result := Result + READER_MENU_KEYS[I].Title;
    end;
  if not AWithPointer then
    Exit;
  for I := 0 to Length(READER_MENU_POINTER) - 1 do
    if SameText(READER_MENU_POINTER[I].Action, AAction) then
    begin
      if Result <> '' then
        Result := Result + ', ';
      Result := Result + READER_MENU_POINTER[I].Gesture;
    end;
end;

function ReaderMenuFirstKey(const AAction: string): string;
var
  I: Integer;
begin
  Result := '';
  for I := 0 to Length(READER_MENU_KEYS) - 1 do
    if SameText(READER_MENU_KEYS[I].Action, AAction) then
      Exit(READER_MENU_KEYS[I].Title);
end;

